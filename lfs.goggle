! --- SECTION 1: PRIMARY MARKETPLACE BOOSTS ---
! These sites are boosted with maximum strength (10).

$boost=10,site=ebay.com
$boost=10,site=vinted.com
$boost=10,site=poshmark.com
$boost=10,site=mercari.com

! --- SECTION 2: SPECIALIZED RESALE BOOSTS ---
! Platforms boosted with high strength (8) for niche luxury and vintage.

$boost=8,site=depop.com
$boost=8,site=grailed.com
$boost=8,site=offerup.com
$boost=8,site=craigslist.org
$boost=8,site=whatnot.com

! --- SECTION 3: SECONDARY LOCAL & NICHE ---
! Boosting community-driven and niche sites (strength 5).

$boost=5,site=etsy.com
$boost=5,site=varagesale.com
$boost=5,site=nextdoor.com

! --- SECTION 4: RETAIL NOISE REDUCTION ---
! Downranks major retail sites to focus on arbitrage opportunities.

$downrank=8,site=amazon.com
$downrank=8,site=walmart.com
$downrank=8,site=target.com
$downrank=8,site=homedepot.com

! --- SECTION 5: DISCARD SPAM & COPYCATS ---
! Removes low-quality sites and content farms.

$discard,site=pinterest.com
$discard,site=w3schools.com
$discard,site=geeksforgeeks.org
